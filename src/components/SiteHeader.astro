---
/**
 * SiteHeader — mieru-ca.com/blog/ レイアウト再現
 *
 * 上段: ロゴ（中央配置）+ 右端リンク群（縦中央揃え、お問い合わせのみ水色背景で高さいっぱい）
 * 区切り: ナビバー上部に 2px 水色ライン
 * 下段: カテゴリ横並び + 右端検索アイコン
 */

const navItems = ['ALL', 'SEO', '生成AI', 'コンテンツ', 'Webマーケ', 'SNS', '特集', 'ニュース'];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white">

  <!-- 上段: ロゴ(中央) + 右端リンク群 -->
  <div class="relative flex h-[93px] items-center justify-center">

    <!-- ロゴ（中央） -->
    <div class="text-center">
      <p class="text-lg font-bold leading-tight text-[var(--color-text)]">ノビテン ジャーナル</p>
      <p class="mt-0.5 text-xs text-[var(--color-muted)]">Webマーケの基礎から応用まで学ぶ！</p>
    </div>

    <!-- 右端リンク群（高さいっぱいの絶対配置） -->
    <div class="absolute top-0 right-0 flex h-full items-stretch">
      <!-- ウェビナー情報 -->
      <a href="#" class="flex w-[90px] flex-col items-center justify-center gap-1 text-[11px] font-bold text-[var(--color-text)] hover:opacity-70">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.069A1 1 0 0121 8.82v6.36a1 1 0 01-1.447.894L15 14M3 8a2 2 0 012-2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z" />
        </svg>
        ウェビナー情報
      </a>
      <!-- 資料一覧 -->
      <a href="#" class="flex w-[90px] flex-col items-center justify-center gap-1 text-[11px] font-bold text-[var(--color-text)] hover:opacity-70">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        資料一覧
      </a>
      <!-- お問い合わせ（水色・高さいっぱい） -->
      <a href="#" class="flex w-[100px] flex-col items-center justify-center gap-1 bg-[#68a9d1] text-[11px] font-bold text-white hover:opacity-90">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        お問い合わせ
      </a>
    </div>
  </div>

  <!-- 下段: カテゴリナビ（上部に2px水色ライン） -->
  <div class="border-t-2 border-b border-[#68a9d1] border-b-[var(--color-border)]">
    <nav class="mx-auto flex max-w-[1180px] items-center">
      {navItems.map((item) => (
        <a
          href="#"
          class="flex h-[40px] items-center px-5 text-[15px] font-bold text-[var(--color-text)] hover:opacity-60"
        >
          {item}
        </a>
      ))}
      <!-- 検索アイコン -->
      <button class="ml-auto flex h-[40px] w-[40px] items-center justify-center text-[var(--color-text)] hover:opacity-60">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
        </svg>
      </button>
    </nav>
  </div>

</header>
