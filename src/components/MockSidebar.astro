---
---
<div class="rounded-xl border-2 border-[var(--color-text)] bg-white p-6">
  <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-muted)]">料金プラン</p>

  <!-- プランA -->
  <div class="mt-4">
    <p class="font-bold text-[var(--color-text)]">通常プラン</p>
    <div class="mt-1 flex gap-2">
      <span class="rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">予約不要</span>
      <span class="rounded bg-neutral-700 px-2 py-0.5 text-xs font-bold text-white">定員5名</span>
    </div>
    <p class="mt-3 text-center text-3xl font-bold text-[var(--color-text)]">
      3,000 <span class="text-sm font-normal">円 / 人</span>
    </p>
    <p class="mt-1 text-center text-sm text-[var(--color-muted)]">奇数時間スタート（11〜17時）</p>
  </div>

  <hr class="my-4 border-[var(--color-border)]" />

  <!-- プランB -->
  <div>
    <p class="font-bold text-[var(--color-text)]">貸切予約プラン</p>
    <div class="mt-1 flex gap-2">
      <span class="rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white">予約制</span>
      <span class="rounded bg-neutral-700 px-2 py-0.5 text-xs font-bold text-white">定員1〜5名</span>
    </div>
    <p class="mt-3 text-center text-3xl font-bold text-[var(--color-text)]">
      10,000 <span class="text-sm font-normal">円 / 枠</span>
    </p>
    <p class="mt-1 text-center text-sm text-[var(--color-muted)]">偶数時間スタート（12〜18時）</p>
  </div>

  <!-- CTAボタン -->
  <div class="mt-6 flex flex-col gap-3">
    <a
      href="#"
      class="block rounded-lg bg-[var(--color-accent)] py-2 text-center text-sm font-bold text-white hover:opacity-90"
    >
      通常プランの詳細
    </a>
    <a
      href="#"
      class="block rounded-lg bg-[var(--color-accent)] py-2 text-center text-sm font-bold text-white hover:opacity-90"
    >
      貸切プランの詳細
    </a>
    <a
      href="#"
      class="block rounded-lg border border-[var(--color-text)] py-2 text-center text-sm font-bold text-[var(--color-text)] hover:bg-[var(--color-surface)]"
    >
      お問い合わせ
    </a>
  </div>
</div>
